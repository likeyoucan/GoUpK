<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="124dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_notification_card">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Секундомер"
        android:textSize="14sp"
        android:textColor="#BFC7D9"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:text="00:00"
        android:textSize="42sp"
        android:textColor="#F5F7FF"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end" />

    <FrameLayout
        android:id="@+id/notif_btn_toggle_wrap"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/notif_btn_toggle_bg"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_btn_circle"
            android:tint="#E2EAFF" />

        <ImageView
            android:id="@+id/notif_btn_toggle_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notif_play"
            android:tint="#2B3038" />
    </FrameLayout>
</LinearLayout>